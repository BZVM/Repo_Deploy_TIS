{
    "name": "sistema-administracion-edificio-devunity-root",
    "private": true,
    "workspaces": [
        "client",
        "server",
        "qa"
    ],
    "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "postinstall": "npm run prisma:generate --workspace=server"
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    }

}
